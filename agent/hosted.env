# Hosted defaults (free tiers), baked into the Docker image and loaded BEFORE the server's .env, which overrides
# any of them. No secrets here: keys, the Supabase URL and TURN credentials go in the server's .env.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_DISABLE_THINKING=true
LLM_REASONING_EFFORT=low
LLM_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b:none
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_MODEL=openai/gpt-oss-120b
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo
EMBED_PROVIDER=fastembed
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
DEMO_MODE=true
MAX_VOICE_SESSIONS=2
MAX_VOICE_SESSION_SECONDS=240
MAX_VOICE_CALLS_PER_DAY=60
RATE_LIMIT_PER_MINUTE=30
WARMUP_ON_STARTUP=true
